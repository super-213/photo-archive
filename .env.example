# 本地访问无需填写 URL，./start.sh 会交互式询问端口并保存到 .env.local。
# 通过 Cloudflare Tunnel 访问后台时，填写实际 HTTPS 域名并重启服务。
# BETTER_AUTH_URL=https://photos.example.com

# 可选。数据库、原图和展示图的本地保存目录，默认 .data。
# PHOTO_ARCHIVE_DATA_DIR=/absolute/path/to/photo-archive-data

# 可选。默认自动生成并保存到数据目录下的 auth-secret。
# BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# 以下项目由部署脚本自动保存。
# PHOTO_ARCHIVE_PORT=3000
# PHOTO_ARCHIVE_ADMIN_EMAIL=you@example.com
# PHOTO_ARCHIVE_ADMIN_PASSWORD_BASE64=base64-encoded-initial-password
