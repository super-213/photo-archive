{
  "name": "photo-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --webpack --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:init": "node --conditions=react-server --import tsx scripts/init.ts",
    "media:rebuild": "node --conditions=react-server --import tsx scripts/rebuild-media.ts",
    "admin:create": "node --conditions=react-server --import tsx scripts/create-admin.ts",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.2.0",
    "@next/env": "^16.4.6",
    "better-auth": "^1.7.20",
    "better-sqlite3": "^13.0.3",
    "busboy": "^1.6.0",
    "exifr": "^7.1.3",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "^1.5.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
